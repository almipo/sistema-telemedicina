# Copiar como .env y adaptar a credenciales LOCALES. No subir .env a GitHub.
# Base de datos relacional (Compose y servicios backend / Alertas)
POSTGRES_DB=telemedicina_dev
DB_USER=telemedicina
DB_PASSWORD=REEMPLAZAR_CONTRASENA_POSTGRES

# MongoDB: credenciales de administrador para la PRIMERA inicialización
# En una base existente no cambia ni recrea sus usuarios.
MONGO_ROOT_USER=REEMPLAZAR_USUARIO_ADMIN_MONGO
MONGO_ROOT_PASSWORD=REEMPLAZAR_CONTRASENA_ADMIN_MONGO

# Conexión autenticada del microservicio Métricas DENTRO de Docker.
# El usuario puede ser distinto del administrador; authSource depende de dónde fue creado.
# Codificar caracteres especiales de usuario/contraseña para su uso en una URI.
MONGO_URI_DOCKER=mongodb://USUARIO:CONTRASENA@mongodb:27017/telemedicina_metricas?authSource=admin

# URLs consumidas por el navegador; no utilizar nombres internos de Docker aquí.
FRONTEND_API_BASE_URL=http://localhost:8080
FRONTEND_METRICAS_API_URL=http://localhost:8081
FRONTEND_ALERTAS_API_URL=http://localhost:8082
FRONTEND_ALERTAS_WS_URL=ws://localhost:8082/ws/alertas
